# NTU/lab public HTTPS deployment. Node stays on loopback; Caddy owns ports 80/443.
FRONTEND_URL=https://progresshub.example.ntu.edu.tw/
PUBLIC_BASE_URL=https://progresshub.example.ntu.edu.tw
HOST=127.0.0.1
PORT=8787
ALLOWED_ORIGINS=https://progresshub.example.ntu.edu.tw,http://127.0.0.1:8787,http://localhost:8787
SERVE_FRONTEND=true
PUBLIC_HEALTH_DETAILS=false

# GitHub OAuth for Engineer / PM login. Secrets remain only in .env.local.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=
GITHUB_ORG=smartport-ntume

# Dedicated managed clone of the private project repository.
PROJECT_REPO=smartport-ntume/SmartPort-Project-Control
PROJECT_REPO_URL=https://github.com/smartport-ntume/SmartPort-Project-Control.git
PROJECT_REPO_PATH=.runtime/SmartPort-Project-Control
PROJECT_BRANCH=main
GIT_AUTO_PULL=true
GIT_AUTO_PUSH=true
GIT_PULL_INTERVAL_MS=10000
GIT_AUTHOR_NAME=SmartPort Local Backend
GIT_AUTHOR_EMAIL=smartport-local@users.noreply.github.com

# Local Codex. Explicit login allowlist is required even for PM accounts.
LOCAL_CODEX_ENABLED=true
LOCAL_CODEX_REQUIRE_PM=true
LOCAL_CODEX_ALLOWED_LOGINS=YOUR_GITHUB_LOGIN
CODEX_BIN=codex
CODEX_MODEL=
CODEX_TIMEOUT_MS=900000
CODEX_MAX_ACTIVE_JOBS=5
LIBREOFFICE_BIN=soffice
KEEP_CODEX_WORKSPACE=false

# Runtime files remain outside Git.
RUNTIME_DIR=.runtime

# Caddy executable/config. Caddy loads the public hostname from .env.caddy.
CADDY_BIN=caddy
CADDYFILE=deploy/Caddyfile
CADDY_ENV_FILE=.env.caddy

# In-memory public endpoint limits. Guest password attempts: 10 per 10 minutes per client IP.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GUEST_LOGIN_WINDOW_MS=600000
RATE_LIMIT_GUEST_LOGIN_MAX=10
RATE_LIMIT_AUTH_MAX=60
RATE_LIMIT_WRITE_MAX=120
RATE_LIMIT_API_MAX=600

# Optional public sanitized snapshot fallback; keep disabled for the direct local deployment.
PUBLIC_SNAPSHOT_ENABLED=false
PUBLIC_REPO_PATH=
PUBLIC_REPO_URL=https://github.com/smartport-ntume/SmartPort-Progress-Hub.git
PUBLIC_REPO_BRANCH=main
PUBLIC_SNAPSHOT_FILE=data/public-snapshot.json
