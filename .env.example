# Supabase Gateway (local Agent only)
# Keep the service-role/secret key in .env.local. Never put it in js/runtime-config.js.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AGENT_ID=vincent-windows-agent
SUPABASE_REPORT_BUCKET=weekly-reports

# Dedicated managed clone of the private project repository.
PROJECT_REPO=smartport-ntume/SmartPort-Project-Control
PROJECT_REPO_URL=https://github.com/smartport-ntume/SmartPort-Project-Control.git
PROJECT_REPO_PATH=.runtime/SmartPort-Project-Control
PROJECT_BRANCH=main
GIT_AUTO_PULL=true
GIT_AUTO_PUSH=true
GIT_PULL_INTERVAL_MS=10000
GIT_AUTHOR_NAME=SmartPort Local Agent
GIT_AUTHOR_EMAIL=smartport-local@users.noreply.github.com

# Optional: leave blank when `gh auth token` works after `gh auth login`.
# The credential needs private repo Issues access. Git push can use Git Credential Manager.
GITHUB_AGENT_TOKEN=
GITHUB_ORG=smartport-ntume

# Local Codex. Run `codex login` as the same Windows account first.
LOCAL_CODEX_ENABLED=true
CODEX_BIN=codex
CODEX_MODEL=
CODEX_TIMEOUT_MS=900000
LIBREOFFICE_BIN=soffice
KEEP_CODEX_WORKSPACE=false

# Runtime files remain outside Git.
RUNTIME_DIR=.runtime

# Legacy loopback HTTP backend rollback settings (`npm run start:local`).
# They are not used by `npm start` / `npm run agent`.
FRONTEND_URL=https://smartport-ntume.github.io/SmartPort-Progress-Hub/
PUBLIC_BASE_URL=http://127.0.0.1:8787
HOST=127.0.0.1
PORT=8787
ALLOWED_ORIGINS=https://smartport-ntume.github.io,http://127.0.0.1:8787,http://localhost:8787
SERVE_FRONTEND=true
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=
LOCAL_CODEX_REQUIRE_PM=true
CODEX_MAX_ACTIVE_JOBS=5
PUBLIC_SNAPSHOT_ENABLED=false
PUBLIC_REPO_PATH=
PUBLIC_REPO_URL=https://github.com/smartport-ntume/SmartPort-Progress-Hub.git
PUBLIC_REPO_BRANCH=main
PUBLIC_SNAPSHOT_FILE=data/public-snapshot.json
