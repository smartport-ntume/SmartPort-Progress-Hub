{
  "name": "smartport-progress-hub",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "SmartPort Progress Hub with an NTU-hosted local backend and local Codex agent",
  "engines": {
    "node": ">=22.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local local-server/server.mjs",
    "start:public": "node --env-file-if-exists=.env.local local-server/server.mjs",
    "doctor": "node --env-file-if-exists=.env.local local-server/doctor.mjs",
    "probe": "node --env-file-if-exists=.env.local local-server/public-probe.mjs",
    "agent:supabase": "node --env-file-if-exists=.env.local local-server/supabase-agent.mjs",
    "doctor:supabase": "node --env-file-if-exists=.env.local local-server/supabase-agent-doctor.mjs",
    "start:local": "node --env-file-if-exists=.env.local local-server/server.mjs",
    "doctor:local": "node --env-file-if-exists=.env.local local-server/doctor.mjs",
    "snapshot": "node --env-file-if-exists=.env.local local-server/publish-snapshot.mjs",
    "check": "node scripts/check-syntax.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "cross-spawn": "^7.0.6",
    "mammoth": "^1.10.0"
  }
}
